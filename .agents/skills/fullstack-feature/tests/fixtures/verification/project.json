{
  "schemaVersion": 1,
  "surfaces": [
    {
      "id": "sample",
      "path": ".",
      "checks": {
        "pass": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "Get-Content -LiteralPath 'test-results-template.json' -Raw | Set-Content -LiteralPath 'test-results.json' -NoNewline"],
          "timeoutSec": 10,
          "testResults": {
            "path": "test-results.json",
            "format": "harness-tests-v1"
          }
        },
        "fail": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "exit 7"],
          "timeoutSec": 10
        },
        "missing": {
          "executable": "harness-command-that-does-not-exist",
          "arguments": [],
          "timeoutSec": 10,
          "testResults": {
            "path": "test-results.json",
            "format": "harness-tests-v1"
          }
        },
        "timeout": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "Start-Process -FilePath 'pwsh' -ArgumentList @('-NoProfile','-Command',\"Start-Sleep -Seconds 3; Set-Content -LiteralPath 'timeout-descendant.marker' -Value 'late'\"); Start-Sleep -Seconds 30"],
          "timeoutSec": 1
        }
      }
    },
    {
      "id": "other",
      "path": ".",
      "checks": {
        "fail": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "exit 13"],
          "timeoutSec": 10
        }
      }
    },
    {
      "id": "dryrun",
      "path": ".",
      "checks": {
        "execute": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "Set-Content -LiteralPath 'dry-run.marker' -Value 'executed'"],
          "timeoutSec": 10
        }
      }
    },
    {
      "id": "collision",
      "path": ".",
      "commandCandidates": [
        {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "Write-Output 'candidate command'"],
          "timeoutSec": 10
        }
      ],
      "checks": {
        "candidate-1": {
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "Write-Output 'named check'"],
          "timeoutSec": 10
        }
      }
    },
    {
      "id": "stale-results",
      "path": ".",
      "checks": {
        "stale": {
          "stage": "integration",
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "(Get-Item -LiteralPath 'test-results.json').LastWriteTimeUtc = [DateTime]::UtcNow; exit 0"],
          "timeoutSec": 10,
          "testResults": {
            "path": "test-results.json",
            "format": "harness-tests-v1"
          }
        }
      }
    },
    {
      "id": "result-swap",
      "path": ".",
      "checks": {
        "swap": {
          "stage": "integration",
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "$linkType = if ($IsWindows) { 'Junction' } else { 'SymbolicLink' }; Remove-Item -LiteralPath 'result-link-dir' -Recurse -Force; New-Item -ItemType $linkType -Path 'result-link-dir' -Target '../verification-outside-results' | Out-Null; exit 0"],
          "timeoutSec": 10,
          "testResults": {
            "path": "result-link-dir/test-results.json",
            "format": "harness-tests-v1"
          }
        }
      }
    },
    {
      "id": "invalid-results",
      "path": ".",
      "checks": {
        "fail": {
          "stage": "integration",
          "executable": "pwsh",
          "arguments": ["-NoProfile", "-Command", "exit 9"],
          "timeoutSec": 10,
          "testResults": {
            "path": "../../../../../../outside-results.json",
            "format": "harness-tests-v1"
          }
        }
      }
    }
  ]
}
