POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=change-me-local-only

# MoMo v2 sandbox credentials for local payment-service testing (do not commit real secrets in .env).
MOMO_PARTNER_CODE=MOMO_LOCAL
MOMO_ACCESS_KEY=local-access-key
MOMO_SECRET_KEY=local-secret-key-change-me
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_REDIRECT_URL=http://localhost:8000/api/v1/payments/momo-redirect
MOMO_IPN_URL=http://localhost:8000/api/v1/payments/momo-ipn
PAYMENT_MOMO_MOCK_ENABLED=true
PAYMENT_REFUND_MAX_AUTO_ATTEMPTS=3
PAYMENT_REFUND_POLL_INTERVAL=2s
PAYMENT_REFUND_RETRY_BACKOFF=10s
