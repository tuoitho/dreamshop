# Copy to .env.production and supply real credentials before starting compose.production.yml.
# Never commit .env.production to version control.

# Host HTTP port published by Kong (sit behind an HTTPS reverse proxy/CDN in production).
PUBLIC_HTTP_PORT=80
IMAGE_TAG=latest
VITE_API_BASE_URL=/api/v1

# PostgreSQL credentials (REQUIRED).
# Use URL-safe characters [A-Za-z0-9_-] (e.g., `openssl rand -hex 24`) because Go services consume DATABASE_URL as a URI.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=

# RabbitMQ credentials (REQUIRED).
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=

# MinIO object storage credentials (REQUIRED; secret >= 8 characters).
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Absolute host directory containing private.pem and public.pem readable by UID 10001.
IDENTITY_KEYS_DIR=/etc/ecommerce/secrets/identity
IDENTITY_JWT_KEY_ID=identity-prod-2026-01
IDENTITY_JWT_ACCESS_TTL=15m
IDENTITY_SESSION_REFRESH_TTL=30d
IDENTITY_SESSION_COOKIE_NAME=refresh_token
IDENTITY_SESSION_COOKIE_PATH=/api/v1/auth
# Keep true behind HTTPS; set to false only when testing plain HTTP without TLS.
IDENTITY_SESSION_COOKIE_SECURE=true

# Optional first-boot SUPER_ADMIN bootstrap (all three must be set together, password 12-128 chars; leave blank to disable).
IDENTITY_BOOTSTRAP_SUPER_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
IDENTITY_BOOTSTRAP_SUPER_ADMIN_FULL_NAME=

# Keep false in production so demo catalog products and stock SKUs are not seeded on startup.
SEED_DEMO_DATA=false

# MoMo v2 payment gateway credentials for payment-service.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=/api/v1/payments/momo-redirect
MOMO_IPN_URL=/api/v1/payments/momo-ipn
PAYMENT_MOMO_MOCK_ENABLED=false

